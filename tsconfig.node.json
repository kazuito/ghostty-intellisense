{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "module": "preserve",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "rolldown.config.ts",
    "scripts/**/*",
    "test/ghostty.ts",
    "test/ghostty-pin.json"
  ],
  "references": [{ "path": "./tsconfig.app.json" }]
}
