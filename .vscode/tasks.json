// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bun: watch",
      "type": "shell",
      "command": "bun",
      "args": ["run", "watch"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "rolldown",
        "pattern": {
          "regexp": "^(?!x)x"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(Waiting for changes|rebuilding\\.\\.\\.)",
          "endsPattern": "Rebuilt"
        }
      },
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
