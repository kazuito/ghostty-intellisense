# Sample Ghostty Configuration

# Language and theme
language = en-US
# theme = dark:tokyonight,light:papercolor
background = #101418
foreground = ivory
background-image = /Users/ghost/Pictures/ghostty-grid.png
background-image-opacity = 0.72
background-image-position = bottom-right
background-image-fit = cover
background-image-repeat = false
selection-foreground = cell-background
selection-background = #3A415B
selection-clear-on-typing = true
selection-clear-on-copy = false
selection-word-chars = -./?_
minimum-contrast = 3.5
palette = 0=#1D2021
palette = 1=#CC241D
palette = 2=#98971A
palette = 3=#D79921
palette = 4=#458588
palette = 5=#B16286
palette-generate = false
palette-harmonious = true
bold-color = bright
faint-opacity = 0.65

# Font stack and shaping
font-family = JetBrains Mono
font-family = Symbols Nerd Font Mono
font-family-bold = JetBrains Mono
font-family-italic = JetBrains Mono
font-family-bold-italic = JetBrains Mono
font-style = SemiBold
font-style-bold = ExtraBold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-synthetic-style = bold, no-italic
font-feature = calt, -liga
font-size = 13.5
font-variation = wght=450
font-variation = slnt=0
font-variation-bold = wght=750
font-variation-italic = slnt=-10
font-variation-bold-italic = slnt=-10
font-codepoint-map = U+2600-U+26FF=Symbols Nerd Font Mono
font-codepoint-map = U+1F300-U+1F5FF=Symbols Nerd Font Mono
clipboard-codepoint-map = U+00A0=
font-thicken = true
font-thicken-strength = 120
font-shaping-break = cursor, no-cursor
alpha-blending = linear-corrected
adjust-cell-width = 4%
adjust-cell-height = 2
adjust-font-baseline = -6%
adjust-underline-position = 8%
adjust-underline-thickness = 1
adjust-strikethrough-position = -3%
adjust-strikethrough-thickness = 1
adjust-overline-position = 5%
adjust-overline-thickness = 1
adjust-cursor-thickness = 12%
adjust-cursor-height = -8%
adjust-box-thickness = 5%
adjust-icon-height = -16.6%
grapheme-width-method = unicode
freetype-load-flags = hinting, no-light

# Cursor, search, and mouse behavior
cursor-color = #FFCC66
cursor-opacity = 0.9
cursor-style = block_hollow
cursor-style-blink = true
cursor-text = cell-foreground
cursor-click-to-move = true
search-foreground = #111827
search-background = #F59E0B
search-selected-foreground = #FFFFFF
search-selected-background = #EF4444
mouse-hide-while-typing = true
scroll-to-bottom = keystroke, no-output
mouse-shift-capture = always
mouse-reporting = false
mouse-scroll-multiplier = 2.75
scrollbar = system
# link = false
link-url = true
link-previews = true

# Window appearance and layout
background-opacity = 0.92
background-opacity-cells = true
background-blur = 18
unfocused-split-opacity = 0.8
unfocused-split-fill = slategray
split-divider-color = #303744
split-preserve-zoom = true
maximize = false
fullscreen = false
title = Ghostty Extension Debug Profile
class = com.mitchellh.ghostty.debug
x11-instance-name = ghostty-debug
working-directory = /Users/ghost/dev/ghostty
window-padding-x = 12, 24
window-padding-y = 8, 16
window-padding-balance = true
window-padding-color = extend-always
window-vsync = true
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = false
window-inherit-font-size = true
window-decoration = auto
window-title-font-family = SF Pro Display
window-subtitle = working-directory
window-theme = ghostty
window-colorspace = display-p3
window-height = 48
window-width = 160
window-position-x = 120
window-position-y = 80
window-save-state = always
window-step-resize = true
window-new-tab-position = end
window-show-tab-bar = always
window-titlebar-background = #16181D
window-titlebar-foreground = #D8DEE9
resize-overlay = always
resize-overlay-position = bottom-right
resize-overlay-duration = 1200ms
focus-follows-mouse = true

# Commands, env, and shell integration
command = /bin/zsh -l
initial-command = tmux new-session -A -s main
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell, notify
notify-on-command-finish-after = 2s
env = COLORTERM=truecolor
env = EDITOR=nvim
env = PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin
input = raw:printf 'bootstrapped\n'
input = path:/Users/ghost/dev/ghostty/test-config
wait-after-command = false
abnormal-command-exit-runtime = 250
scrollback-limit-bytes = 200000
scrollback-limit-lines = unlimited
shell-integration = zsh
shell-integration-features = cursor, sudo, title, ssh-env, no-path
osc-color-report-format = 16-bit
vt-kam-allowed = false
term = xterm-ghostty
enquiry-response = ghostty-debug
async-backend = auto

# Keymaps and command palette
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+enter=new_tab
keybind = alt+enter=toggle_fullscreen
# key-remap = caps_lock=escape
command-palette-entry = title:Reload Config,action:reload_config
command-palette-entry = title:Open Split Right,action:new_split:right

# Clipboard and click behavior
clipboard-read = ask
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = false
title-report = false
image-storage-limit = 640000000
copy-on-select = both
middle-click-action = primary-paste
right-click-action = copy-or-paste
click-repeat-interval = 350

# Config chaining and lifecycle
# config-file = /Users/ghost/.config/ghostty/base
# config-file = /Users/ghost/.config/ghostty/work
config-default-files = true
confirm-close-surface = always
quit-after-last-window-closed = false
quit-after-last-window-closed-delay = 1500ms
initial-window = true
undo-timeout = 15s

# Quick terminal
quick-terminal-position = center
quick-terminal-size = 42.5%
gtk-quick-terminal-layer = overlay
gtk-quick-terminal-namespace = dev.ghost.ghostty.debug
quick-terminal-screen = mouse
quick-terminal-animation-duration = 180
quick-terminal-autohide = true
quick-terminal-space-behavior = remain
quick-terminal-keyboard-interactivity = exclusive

# Shaders, bell, and notifications
custom-shader = /Users/ghost/dev/shaders/crt-warp.glsl
custom-shader = /Users/ghost/dev/shaders/chromatic-aberration.glsl
custom-shader-animation = always
bell-features = system, attention, title, no-border
bell-audio-path = /System/Library/Sounds/Glass.aiff
bell-audio-volume = 0.4
app-notifications = true
desktop-notifications = true
# progress-style = false

# macOS-specific toggles
macos-non-native-fullscreen = visible-menu
macos-window-buttons = visible
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = visible
macos-dock-drop-behavior = new-window
macos-option-as-alt = right
macos-window-shadow = true
macos-hidden = never
macos-auto-secure-input = true
macos-secure-input-indication = true
macos-applescript = true
macos-icon = custom-style
macos-icon-frame = chrome
macos-icon-ghost-color = #7AA2F7
macos-icon-screen-color = #0B0F14, #1B2430, #2F3B54
macos-shortcuts = ask

# Linux and GTK-specific toggles
linux-cgroup = single-instance
linux-cgroup-memory-limit = 2147483648
linux-cgroup-processes-limit = 512
linux-cgroup-hard-fail = false
gtk-opengl-debug = false
gtk-single-instance = detect
gtk-titlebar = true
gtk-tabs-location = top
gtk-titlebar-hide-when-maximized = true
gtk-toolbar-style = raised-border
gtk-titlebar-style = tabs
gtk-wide-tabs = false
gtk-custom-css = /Users/ghost/.config/ghostty/debug.css
gtk-custom-css = /Users/ghost/.config/ghostty/overrides.css

# Update behavior
auto-update = check
auto-update-channel = stable
