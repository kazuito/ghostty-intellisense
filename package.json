{
  "name": "ghostty",
  "displayName": "Ghostty IntelliSense",
  "description": "Language support, validation, formatting, quick fixes, and outlines for Ghostty config files.",
  "version": "1.0.7",
  "publisher": "kazuito",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kazuito/ghostty-intellisense.git"
  },
  "homepage": "https://github.com/kazuito/ghostty-intellisense",
  "bugs": {
    "url": "https://github.com/kazuito/ghostty-intellisense/issues"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "vscode": "^1.91.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "ghostty.executablePath"
      ]
    }
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "ghostty",
    "terminal",
    "config",
    "formatter"
  ],
  "icon": "assets/icon.png",
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "bun run bundle",
    "bundle": "NODE_ENV=production rolldown --config rolldown.config.ts",
    "bundle:dev": "rolldown --config rolldown.config.ts",
    "watch": "rolldown --config rolldown.config.ts --watch",
    "gen:config": "bun scripts/gen-config.ts && biome format --write src/generated/config-keys.ts syntaxes/ghostty-config.tmLanguage.json",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write --unsafe && bun run typecheck",
    "test": "bun test src/test && bun run test:grammar",
    "test:grammar": "vscode-tmgrammar-test 'src/test/*.test.ghostty'",
    "typecheck": "tsc -b",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "~26.1.2",
    "@types/vscode": "^1.91.0",
    "lefthook": "^2.1.16",
    "rolldown": "^1.2.11",
    "typescript": "^7.0.2",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "ghostty-config",
        "aliases": [
          "Ghostty Config"
        ],
        "filenamePatterns": [
          "**/ghostty/config",
          "**/com.mitchellh.ghostty/config"
        ],
        "extensions": [
          ".ghostty"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ghostty-config",
        "scopeName": "source.ghostty",
        "path": "./syntaxes/ghostty-config.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Ghostty IntelliSense",
      "properties": {
        "ghostty.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `ghostty` executable. When empty, the extension searches the system `PATH` plus common per-platform install locations (e.g. `/Applications/Ghostty.app/Contents/MacOS` and Nix paths on macOS; `/usr/local/bin`, `/usr/bin`, Homebrew-on-Linux, Snap, and Nix paths on Linux). Not auto-detected under Flatpak — see README. Set this if Ghostty is installed elsewhere."
        },
        "ghostty.format.equalSpacing": {
          "type": "string",
          "enum": [
            "space",
            "no-space",
            "preserve"
          ],
          "enumDescriptions": [
            "Normalize to 'key = value' (space on both sides of '=').",
            "Normalize to 'key=value' (no spaces around '=').",
            "Leave spacing around '=' as-is."
          ],
          "default": "space",
          "markdownDescription": "Spacing around `=` in config entries."
        },
        "ghostty.format.blankLines": {
          "type": "string",
          "enum": [
            "collapse",
            "preserve"
          ],
          "enumDescriptions": [
            "Collapse multiple consecutive blank lines into one.",
            "Leave blank lines as-is."
          ],
          "default": "collapse",
          "description": "How to handle consecutive blank lines."
        },
        "ghostty.format.colorCase": {
          "type": "string",
          "enum": [
            "uppercase",
            "lowercase",
            "preserve"
          ],
          "enumDescriptions": [
            "Normalize hex color digits to uppercase (e.g. #1A1B26).",
            "Normalize hex color digits to lowercase (e.g. #1a1b26).",
            "Leave hex color digit casing as-is."
          ],
          "default": "uppercase",
          "description": "Case normalization for hex color values."
        },
        "ghostty.format.colorAddPrefix": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ensure hex colors are prefixed with `#` (e.g. `1a1b26` → `#1A1B26`). Does not affect named colors."
        },
        "ghostty.format.booleanCase": {
          "type": "string",
          "enum": [
            "lowercase",
            "preserve"
          ],
          "enumDescriptions": [
            "Normalize boolean literals to lowercase (true/false).",
            "Leave boolean casing as-is."
          ],
          "default": "lowercase",
          "description": "Case normalization for boolean values."
        },
        "ghostty.format.commaSpacing": {
          "type": "string",
          "enum": [
            "space",
            "no-space",
            "preserve"
          ],
          "enumDescriptions": [
            "Normalize to 'a, b' (space after comma).",
            "Normalize to 'a,b' (no space after comma).",
            "Leave comma spacing as-is."
          ],
          "default": "space",
          "description": "Spacing after commas in comma-separated values."
        },
        "ghostty.format.trimWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Trim leading and trailing whitespace from config key/value lines."
        }
      }
    }
  }
}
